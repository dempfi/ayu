{
  "name": "ayu",
  "version": "6.2.0",
  "private": true,
  "description": "Sublime theme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dempfi/ayu.git"
  },
  "author": "Ike Ku",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dempfi/ayu/issues"
  },
  "homepage": "https://github.com/dempfi/ayu#readme",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsx ./src/build.ts",
    "start": "tsx --watch ./src/build.ts",
    "test": "tsx --test src/templates/*.test.ts",
